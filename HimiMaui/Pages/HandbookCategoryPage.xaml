<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Himi.Pages.HandbookCategoryPage"
    Title="{Binding Title}">

    <Grid Padding="16" RowDefinitions="Auto,*" RowSpacing="12">
        <SearchBar Grid.Row="0"
                   Placeholder="{Binding SearchPlaceholder}"
                   Text="{Binding SearchText, Mode=TwoWay}"
                   Keyboard="Text" />

        <CollectionView Grid.Row="1"
                        x:Name="ArticlesView"
                        ItemsSource="{Binding Articles}"
                        SelectionMode="Single"
                        SelectionChanged="OnArticleSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="14" RowDefinitions="Auto,Auto" Margin="0,0,0,10"
                          BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                        <Grid.Shadow>
                            <Shadow Brush="#000000" Opacity="0.08" Radius="10" Offset="0,4" />
                        </Grid.Shadow>

                        <Label Grid.Row="0" Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="{Binding Summary}" Opacity="0.75" LineBreakMode="TailTruncation" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>

