<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Himi.Pages.ArticlePage"
    Title="{Binding Title}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0"
                             Padding="12,8"
                             Spacing="8"
                             IsVisible="{Binding ShowNewsActions}">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0"
                        Text="{Binding TranslateLabel}"
                        Command="{Binding TranslateCommand}"
                        IsEnabled="{Binding CanTranslate}" />
                <Button Grid.Column="1"
                        Text="{Binding AskQuestionLabel}"
                        Command="{Binding AskQuestionCommand}"
                        IsEnabled="{Binding CanAsk}" />
            </Grid>

            <Button Text="{Binding TranslationToggleLabel}"
                    Command="{Binding ToggleTranslationCommand}"
                    IsVisible="{Binding ShowTranslationToggle}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>

        <WebView Grid.Row="1" Source="{Binding HtmlSource}" />
    </Grid>
</ContentPage>
